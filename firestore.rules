rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: /users/{userId}/settings
    // Document ID: main
    // Fields:
    //   - salary: number (required)
    //   - updatedAt: string (ISO date)
    //
    // Collection: /users/{userId}/expenses
    // Document ID: auto-generated or UUID
    // Fields:
    //   - uid: string (required, must match auth.uid)
    //   - value: number (required, > 0)
    //   - description: string (required, 1-100 chars)
    //   - category: string (required)
    //   - date: string (required, YYYY-MM-DD)
    //   - isFixed: bool
    //   - isRecurring: bool
    //   - repeatCount: number
    //   - repeatFrequency: string (monthly|yearly)
    //   - notes: string (max 500 chars)
    //   - parentId: string
    //   - isPaid: bool
    //   - paidMonths: list (strings YYYY-MM)
    //   - order: number
    //
    // Collection: /users/{userId}/additionalSalaries
    // Document ID: auto-generated or UUID
    // Fields:
    //   - uid: string (required, must match auth.uid)
    //   - value: number (required, > 0)
    //   - description: string (required, 1-100 chars)
    //   - date: string (required, YYYY-MM-DD)
    //   - order: number
    //
    // Collection: /users/{userId}/debtors
    // Document ID: auto-generated or UUID
    // Fields:
    //   - uid: string (required, must match auth.uid)
    //   - value: number (required, > 0)
    //   - description: string (required, 1-100 chars)
    //   - date: string (required, YYYY-MM-DD)
    //   - isFixed: bool
    //   - isRecurring: bool
    //   - repeatCount: number
    //   - repeatFrequency: string (monthly|yearly)
    //   - notes: string (max 500 chars)
    //   - parentId: string
    //   - isReceived: bool
    //   - receivedMonths: list (strings YYYY-MM)
    //   - order: number
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(val, min, max) {
      return val is string && val.size() >= min && val.size() <= max;
    }

    function isValidNumber(val, min) {
      return val is number && val >= min;
    }

    function isValidDate(val) {
      return val is string && val.matches("^\\d{4}-\\d{2}-\\d{2}$");
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidExpense(data) {
      return data.keys().hasAll(['uid', 'value', 'description', 'category', 'date']) &&
             data.uid == request.auth.uid &&
             isValidNumber(data.value, 0) &&
             isValidString(data.description, 1, 100) &&
             isValidDate(data.date) &&
             (!('dueDate' in data) || data.dueDate == "" || isValidDate(data.dueDate)) &&
             (!('order' in data) || data.order is number);
    }

    function isValidAdditionalSalary(data) {
      return data.keys().hasAll(['uid', 'value', 'description', 'date']) &&
             data.uid == request.auth.uid &&
             isValidNumber(data.value, 0) &&
             isValidString(data.description, 1, 100) &&
             isValidDate(data.date) &&
             (!('order' in data) || data.order is number);
    }

    function isValidDebtor(data) {
      return data.keys().hasAll(['uid', 'value', 'description', 'date']) &&
             data.uid == request.auth.uid &&
             isValidNumber(data.value, 0) &&
             isValidString(data.description, 1, 100) &&
             isValidDate(data.date);
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['userId', 'userName', 'userEmail', 'stars', 'message', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.stars >= 1 && data.stars <= 5 &&
             isValidString(data.message, 1, 1000);
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['salary']) &&
             isValidNumber(data.salary, 0) &&
             (!('secondarySalary' in data) || isValidNumber(data.secondarySalary, 0)) &&
             (!('dashboardOrder' in data) || data.dashboardOrder is list);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == "loukianoslimes@gmail.com";
    }

    match /app_users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.status == 'pending');
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /settings/main {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if (isOwner(userId) || isAdmin()) && isValidSettings(request.resource.data);
      }
      
      match /expenses/{expenseId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidExpense(request.resource.data);
        allow update: if isOwner(userId) && isValidExpense(request.resource.data) && 
                         request.resource.data.uid == resource.data.uid;
        allow delete: if isOwner(userId);
      }

      match /additionalSalaries/{salaryId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidAdditionalSalary(request.resource.data);
        allow update: if isOwner(userId) && isValidAdditionalSalary(request.resource.data) && 
                         request.resource.data.uid == resource.data.uid;
        allow delete: if isOwner(userId);
      }

      match /debtors/{debtorId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidDebtor(request.resource.data);
        allow update: if isOwner(userId) && isValidDebtor(request.resource.data) && 
                         request.resource.data.uid == resource.data.uid;
        allow delete: if isOwner(userId);
      }
    }

    match /system/config {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.email == "loukianoslimes@gmail.com";
    }

    match /feedbacks/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow write: if isOwner(userId) && isValidFeedback(request.resource.data);
    }
  }
}
